# This file is a part of the LWD project, layered on the official
# vllm-ascend image (https://quay.io/ascend/vllm-ascend).
#

# BASE_TAG (optional): tag of the official vllm-ascend image to layer on.
# It must satisfy BOTH pins of the forks: the torch pin of the vllm fork
# (if pip reinstalls torch, it fights the baked torch-npu) and the CANN
# version the vllm-ascend fork's csrc is written against (the rc2 image
# moved to CANN 9.2.0 and rejects the fork's 9.1.0-era op definitions).
ARG BASE_IMAGE="quay.io/ascend/vllm-ascend"
ARG BASE_TAG="v0.30.0rc1"

FROM ${BASE_IMAGE}:${BASE_TAG}

SHELL ["/bin/bash", "-c"]

WORKDIR /workspace

# Swap in the vllm fork. The base image installs the package in editable
# mode from /vllm-workspace, so replacing the tree and re-running the
# editable install is all that is needed.
COPY vllm/ /vllm-workspace/vllm/

# Overlay the vllm-ascend sources without deleting anything: the base
# image's prebuilt csrc artifacts (csrc/build, loaded at runtime) must
# survive the swap, exactly like a git checkout on a real machine.
COPY vllm-ascend/ /tmp/lwd-vllm-ascend/
RUN tar -C /tmp/lwd-vllm-ascend --exclude=.git -cf - . | \
        tar -C /vllm-workspace/vllm-ascend -xf - && \
    rm -rf /tmp/lwd-vllm-ascend

# Reinstall vLLM from the LWD fork with the manual workflow's command
# (AGENTS.md). The base image already satisfies every runtime dependency;
# letting pip re-resolve them drifts the pinned stack (issue #37).
RUN cd /vllm-workspace/vllm && \
    VLLM_TARGET_DEVICE=empty python3 -m pip install -v -e . && \
    python3 -m pip cache purge

# Reinstall vllm-ascend from the LWD fork as pure Python with the manual
# workflow's --no-deps/--no-build-isolation, keeping the base image's
# prebuilt custom kernels. Dependency resolution must stay off: it would
# re-pull x86 triton from PyPI and break the base image's triton-ascend
# stack (issue #37).
# TODO(lwd): build the fork's csrc once it compiles cleanly again (issue #18).
RUN cd /vllm-workspace/vllm-ascend && \
    COMPILE_CUSTOM_KERNELS=0 python3 -m pip install -v -e . --no-build-isolation --no-deps && \
    python3 -m pip cache purge

# Rebuild the Rust frontend from the LWD fork's sources.
ENV PATH="/root/.cargo/bin:${PATH}"
RUN cd /vllm-workspace/vllm && \
    export PROTOC_INCLUDE=/usr/include && \
    python3 -m pip install setuptools-rust && \
    ./build_rust.sh

# Install lwd-tool (the LWD launch CLI) plus its model profiles; pure Python,
# and pyyaml is already in the base image. --no-deps keeps the pinned stack
# untouched; the checkout lives under ci/ in the build context (see
# lwd_image.yml).
COPY ci/pyproject.toml ci/README.md ci/LICENSE /tmp/lwd-tool-src/
COPY ci/lwd_tool/ /tmp/lwd-tool-src/lwd_tool/
COPY ci/lwd_checks/ /tmp/lwd-tool-src/lwd_checks/
RUN python3 -m pip install --no-deps /tmp/lwd-tool-src && \
    rm -rf /tmp/lwd-tool-src && \
    lwd-tool plan --help > /dev/null

CMD ["/bin/bash"]
